{
  "manifest_version": 3,
  "name": "SugarCube",
  "version": "1.0.0",
  "description": "Get your coupons, fine lad!",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "assets/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "32": "assets/icon.png"
  }
}
